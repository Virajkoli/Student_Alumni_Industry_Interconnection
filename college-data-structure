Select query for fetch informatin of Hostel--------------------------------
const getHostelDataByCollegeId = async (collegeId) => {
  const hostelFacilities = await db.query(
    "SELECT facility FROM hostel_facilities WHERE college_id = $1",
    [collegeId]
  );

  const campusAmenities = await db.query(
    "SELECT amenity FROM campus_amenities WHERE college_id = $1",
    [collegeId]
  );

  const roomTypes = await db.query(
    "SELECT type, capacity, fee FROM room_types WHERE college_id = $1",
    [collegeId]
  );

  const mess = await db.query(
    "SELECT info FROM mess_info WHERE college_id = $1 LIMIT 1",
    [collegeId]
  );

  return {
    hostelFacilities: hostelFacilities.rows.map((row) => row.facility),
    campusAmenities: campusAmenities.rows.map((row) => row.amenity),
    roomTypes: roomTypes.rows,
    messInfo: mess.rows.length ? mess.rows[0].info : "",
  };
};

