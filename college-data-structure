insert query for Save or dit Button-----------------------
const saveHostelData = async (collegeId, data) => {
  await db.query("BEGIN");

  await db.query("DELETE FROM hostel_facilities WHERE college_id = $1", [collegeId]);
  await Promise.all(
    data.hostelFacilities.map((f) =>
      db.query("INSERT INTO hostel_facilities (college_id, facility) VALUES ($1, $2)", [collegeId, f])
    )
  );

  await db.query("DELETE FROM campus_amenities WHERE college_id = $1", [collegeId]);
  await Promise.all(
    data.campusAmenities.map((a) =>
      db.query("INSERT INTO campus_amenities (college_id, amenity) VALUES ($1, $2)", [collegeId, a])
    )
  );

  await db.query("DELETE FROM room_types WHERE college_id = $1", [collegeId]);
  await Promise.all(
    data.roomTypes.map((room) =>
      db.query(
        "INSERT INTO room_types (college_id, type, capacity, fee) VALUES ($1, $2, $3, $4)",
        [collegeId, room.type, room.capacity, room.fee]
      )
    )
  );

  await db.query("DELETE FROM mess_info WHERE college_id = $1", [collegeId]);
  await db.query("INSERT INTO mess_info (college_id, info) VALUES ($1, $2)", [
    collegeId,
    data.messInfo || "",
  ]);

  await db.query("COMMIT");
};


