--College Table--------------------
CREATE TABLE colleges (
    id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100) NOT NULL,
    description TEXT,
    location VARCHAR(100),
    established YEAR,
    campusArea DECIMAL(10,2),
    nirfRank INT,
    accreditation VARCHAR(100),
    totalStudents INT,
    totalFaculty INT,
    website VARCHAR(255),
    logoUrl VARCHAR(255),
    backgroundUrl VARCHAR(255),
    createdAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updatedAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

-- Departments----------------------------
CREATE TABLE college_departments (
    id INT PRIMARY KEY AUTO_INCREMENT,
    collegeId INT NOT NULL,
    name VARCHAR(100) NOT NULL,
    description TEXT,
    FOREIGN KEY (collegeId) REFERENCES Colleges(id) ON DELETE CASCADE
);

-- Academic Programs---------------------------------------
CREATE TABLE college_rograms (
    id INT PRIMARY KEY AUTO_INCREMENT,
    collegeId INT NOT NULL,
    name VARCHAR(100) NOT NULL,
    type ENUM('UG', 'PG', 'PhD', 'Diploma', 'Certificate') NOT NULL,
    durationYears INT,
    eligibility TEXT,
    fee DECIMAL(10,2),
    totalSeats INT,
    FOREIGN KEY (collegeId) REFERENCES Colleges(id) ON DELETE CASCADE
);

-- Courses---------------------------------
CREATE TABLE college_courses (
    id INT PRIMARY KEY AUTO_INCREMENT,
    programId INT NOT NULL,
    name VARCHAR(100) NOT NULL,
    code VARCHAR(20),
    syllabusUrl VARCHAR(255),
    FOREIGN KEY (programId) REFERENCES Programs(id) ON DELETE CASCADE
);

-- Faculty----------------------------------------------
CREATE TABLE college_Faculty (
    id INT PRIMARY KEY AUTO_INCREMENT,
    collegeId INT NOT NULL,
    departmentId INT,
    name VARCHAR(100) NOT NULL,
    designation VARCHAR(100),
    specialization VARCHAR(100),
    qualifications TEXT,
    bio TEXT,
    email VARCHAR(100),
    profileUrl VARCHAR(255),
    FOREIGN KEY (collegeId) REFERENCES Colleges(id) ON DELETE CASCADE,
    FOREIGN KEY (departmentId) REFERENCES Departments(id) ON DELETE SET NULL
);

-- Admissions--------------------------------------------
CREATE TABLE college_admissions (
    id INT PRIMARY KEY AUTO_INCREMENT,
    collegeId INT NOT NULL,
    programId INT,
    process TEXT,
    requirements TEXT,
    deadline DATE,
    examRequired VARCHAR(100),
    FOREIGN KEY (collegeId) REFERENCES Colleges(id) ON DELETE CASCADE,
    FOREIGN KEY (programId) REFERENCES Programs(id) ON DELETE SET NULL
);

-- Placements----------------------------------------------------
CREATE TABLE college_placements (
    id INT PRIMARY KEY AUTO_INCREMENT,
    collegeId INT NOT NULL,
    highestPackage DECIMAL(10,2),
    averagePackage DECIMAL(10,2),
    topRecruiters TEXT,
    totalCompanies INT,
    internshipOpportunities TEXT,
    FOREIGN KEY (collegeId) REFERENCES Colleges(id) ON DELETE CASCADE
);

-- Documents---------------------------------------
CREATE TABLE college_documents (
    id INT PRIMARY KEY AUTO_INCREMENT,
    collegeId INT NOT NULL,
    name VARCHAR(255) NOT NULL,
    type ENUM('form', 'brochure', 'syllabus', 'other') NOT NULL,
    description TEXT,
    fileSize VARCHAR(20),
    format VARCHAR(10),
    url VARCHAR(255) NOT NULL,
    FOREIGN KEY (collegeId) REFERENCES Colleges(id) ON DELETE CASCADE
);

-- Reviews--------------------------------------------
CREATE TABLE college_reviews (
    id INT PRIMARY KEY AUTO_INCREMENT,
    collegeId INT NOT NULL,
    userId INT NOT NULL,
    rating DECIMAL(2,1) NOT NULL,
    academics DECIMAL(2,1),
    placements DECIMAL(2,1),
    infrastructure DECIMAL(2,1),
    faculty DECIMAL(2,1),
    campusLife DECIMAL(2,1),
    value DECIMAL(2,1),
    comment TEXT,
    createdAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (collegeId) REFERENCES Colleges(id) ON DELETE CASCADE
    -- In production: FOREIGN KEY (userId) REFERENCES Users(id)
);

-- Notifications-------------------------------------------------
CREATE TABLE college_notifications (
    id INT PRIMARY KEY AUTO_INCREMENT,
    collegeId INT NOT NULL,
    title VARCHAR(100) NOT NULL,
    message TEXT NOT NULL,
    createdAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    isRead BOOLEAN DEFAULT FALSE,
    FOREIGN KEY (collegeId) REFERENCES Colleges(id) ON DELETE CASCADE
);

-- Alumni-------------------------------------------------------------
CREATE TABLE college_alumni (
    id INT PRIMARY KEY AUTO_INCREMENT,
    collegeId INT NOT NULL,
    userId INT NOT NULL,
    name VARCHAR(100) NOT NULL,
    graduationYear YEAR,
    program VARCHAR(100),
    currentPosition VARCHAR(100),
    company VARCHAR(100),
    linkedinUrl VARCHAR(255),
    FOREIGN KEY (collegeId) REFERENCES Colleges(id) ON DELETE CASCADE
    -- In production: FOREIGN KEY (userId) REFERENCES Users(id)
);

-- Events---------------------------------------------------------------
CREATE TABLE college_events (
    id INT PRIMARY KEY AUTO_INCREMENT,
    collegeId INT NOT NULL,
    title VARCHAR(100) NOT NULL,
    description TEXT,
    eventDate DATETIME,
    location VARCHAR(255),
    imageUrl VARCHAR(255),
    FOREIGN KEY (collegeId) REFERENCES Colleges(id) ON DELETE CASCADE
);





