{
  "name": "scaips-backend",
  "version": "1.0.0",
  "description": "Backend API for Student College Alumni Industry Professional Startup (SCAIPS) platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:undo": "npx sequelize-cli db:seed:undo:all",
    "db:create": "npx sequelize-cli db:create",
    "db:drop": "npx sequelize-cli db:drop",
    "setup-render": "node scripts/setupRenderDB.js",
    "test-db": "node scripts/testDatabase.js",
    "troubleshoot": "node scripts/troubleshootDB.js",
    "db:reset": "npm run migrate:undo && npm run migrate && npm run seed",
    "db:users": "node scripts/viewUsers.js",
    "db:adduser": "node scripts/addUser.js"
  },
  "keywords": [
    "express",
    "postgresql",
    "sequelize",
    "jwt",
    "authentication",
    "alumni",
    "student",
    "startup"
  ],
  "author": "SCAIPS Team",
  "license": "MIT",
  "dependencies": {
    "@fortawesome/react-fontawesome": "^0.2.2",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^1.30.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.1.0",
    "express": "^4.21.2",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.0",
    "sequelize-cli": "^6.6.2",
    "streamifier": "^0.1.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
